@model PaymentConfigureModel

<div class="form-group">
    <div class="form-check form-check-inline mb-2">
        <label asp-for="@Model.Enabled" class="form-check-label ml-2"></label><span data-required></span>
        <input asp-for="@Model.Enabled" class="form-check-input" type="checkbox" />
    </div>
    <div class="custom-input-set mb-2">
        <label asp-for="@Model.FormNbrTemplate" class="form-label"></label>
        <input asp-for="@Model.FormNbrTemplate" type="text" class="form-control" autocomplete="off" />
    </div>
    <div class="custom-input-set mb-2">
        <label asp-for="@Model.FormNbrCount" class="form-label"></label>
        <input asp-for="@Model.FormNbrCount" type="number" class="form-control" autocomplete="off" />
    </div>
    <div class="custom-input-set mb-2">
        <label asp-for="@Model.FormNbrIncrementCount" class="form-label"></label>
        <input asp-for="@Model.FormNbrIncrementCount" type="number" class="form-control" autocomplete="off" />
    </div>
    <div class="custom-input-set mb-2">
        <label asp-for="@Model.ItemsPageSize" class="form-label"></label>
        <input asp-for="@Model.ItemsPageSize" type="number" class="form-control" autocomplete="off" />
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label asp-for="@Model.AutoGeneratedFormNbr" class="form-check-label ml-2"></label>
        <input asp-for="@Model.AutoGeneratedFormNbr" class="form-check-input" type="checkbox" />
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label asp-for="@Model.InventoryEnabled" class="form-check-label ml-2"></label>
        <input asp-for="@Model.InventoryEnabled" class="form-check-input" type="checkbox" />
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label asp-for="@Model.ApprovalEnabled" class="form-check-label ml-2"></label>
        <input asp-for="@Model.ApprovalEnabled" class="form-check-input" type="checkbox" />
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label asp-for="@Model.AllowAddItemEnabled" class="form-check-label ml-2"></label>
        <input asp-for="@Model.AllowAddItemEnabled" class="form-check-input" type="checkbox" />
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label asp-for="@Model.AllowEditDateEnabled" class="form-check-label ml-2"></label>
        <input asp-for="@Model.AllowEditDateEnabled" class="form-check-input" type="checkbox" />
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label asp-for="@Model.InlineAddEnabled" class="form-check-label ml-2"></label>
        <input asp-for="@Model.InlineAddEnabled" class="form-check-input" type="checkbox" />
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label asp-for="@Model.OpenDocOnCreate" class="form-check-label ml-2"></label>
        <input asp-for="@Model.OpenDocOnCreate" class="form-check-input" type="checkbox" />
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label asp-for="@Model.ShowItemCodeInGrid" class="form-check-label ml-2"></label>
        <input asp-for="@Model.ShowItemCodeInGrid" class="form-check-input" type="checkbox" />
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label asp-for="@Model.RedirectUsingFormNbrEnabled" class="form-check-label ml-2"></label>
        <input asp-for="@Model.RedirectUsingFormNbrEnabled" class="form-check-input" type="checkbox" />
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label asp-for="@Model.FormApiEnabled" class="form-check-label ml-2"></label>
        <input asp-for="@Model.FormApiEnabled" class="form-check-input" type="checkbox" />
    </div>
</div>