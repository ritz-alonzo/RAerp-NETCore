@model OrderConfigureModel

<div class="form-group">
    <div class="mb-2">Product Types:</div>
    <select asp-for="MappedCatalogTypeIds"
            class="multi-select form-control"
            multiple="multiple"
            asp-items="@(new SelectList(Model.AvailableCatalogTypes, "Value", "Text"))">
    </select>
</div>

<div class="form-group">
    <div class="mb-2">Service Types:</div>
    <select asp-for="MappedServiceTypeIds"
            class="multi-select form-control"
            multiple="multiple"
            asp-items="@(new SelectList(Model.AvailableServiceTypes, "Value", "Text"))">
    </select>
</div>
