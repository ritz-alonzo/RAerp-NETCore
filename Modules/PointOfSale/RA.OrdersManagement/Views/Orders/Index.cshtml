@model OrderModel

@{
    ViewData["Title"] = Model.FormTypeName;
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    HtmlActiveNodeMenu.SetActivePluginMenu(Context, Model.FormTypeSystemName);
}

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(c => c.Id)
    <div class="col-md-12"><h2>@Model.FormNbr</h2></div>
    <div class="col-12">
        <div class="float-right">
            @if (Model.Status == FormStatus.Pending || Model.Status == FormStatus.Onhold || Model.Status == FormStatus.AwaitingApproval)
            {
                <input type="submit" value="Save" class="btn btn-success" />
            }
            @if (Model.FormSettings.ApprovalEnabled)
            {   if (Model.Status == FormStatus.Onhold)
                {
                    <input type="submit" value="For Approval" asp-route-actionType="ForApproval" />
                }
                if (Model.Status == FormStatus.AwaitingApproval)
                {
                    <input type="submit" value="Approve" asp-route-actionType="Approve" />
                }
                if (Model.Status == FormStatus.Approved)
                {
                    <input type="submit" value="Release" asp-route-actionType="Release" />
                }
            }
            else
            {
                if (Model.Status == FormStatus.Onhold)
                {
                    <input type="submit" value="Release" asp-route-actionType="Release" />
                }
            }
        </div>
        <div class="float-left">
            <a asp-action="List" asp-controller="Orders"><i class="fa fa-arrow-left"></i> Back to List</a>
        </div>
    </div>
    <br />
    <br />
    <hr />
    <div class="row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @await Html.PartialAsync("_CreateAndEdit.cshtml", Model)
    </div>
</form>

@section scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

