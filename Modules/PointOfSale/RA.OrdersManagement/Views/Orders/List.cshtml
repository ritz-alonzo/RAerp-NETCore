@model OrderSearchModel
@{
    ViewData["Title"] = @Model.FormTypeName;
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    HtmlActiveNodeMenu.SetActivePluginMenu(Context, Model.FormTypeSystemName);
}

<div class="float-right">
    <a asp-action="Create" 
    class="btn btn-primary"
    asp-controller="Orders">
    <i class="fa fa-plus"></i> 
    Create
    </a>
</div>
<div class="col-md-9">
    <h2>@Model.FormTypeName</h2>
</div>
<form-search id="orders_search">
    @Html.HiddenFor(c => c.FormTypeName)
    @Html.HiddenFor(c => c.PageNumber)
    @Html.HiddenFor(c => c.PageSize)
    @Html.HiddenFor(c => c.TotalItems)
    <div id="search">
        <div class="card">
            <div class="card-header-search">
                <h4 class="text-muted">Search</h4>
            </div>
            <div class="card-body-search">
                 <div class="row">
                    <div class="col-md-6">
                        <div class="custom-input-set mb-2">
                            <label asp-for="SearchQuery" class="form-label"></label>
                            <input asp-for="SearchQuery" class="form-control" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="custom-input-set mb-2">
                            <label asp-for="SearchOrderDate" class="form-label"></label>
                            <input asp-for="SearchOrderDate" id="datepicker-autoclose" class="form-control" type="date" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="custom-input-set mb-2">
                            <label asp-for="SearchCreatedOn" class="form-label"></label>
                            <input asp-for="SearchCreatedOn" id="datepicker-autoclose" class="form-control" type="date" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="custom-input-set mb-2">
                            <label asp-for="SearchCustomerName" class="form-label"></label>
                            <input asp-for="SearchCustomerName" class="form-control" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="custom-input-set mb-2">
                            <label asp-for="SearchServiceId" class="form-label"></label>
                            <select asp-for="SearchServiceId"
                                    class="select2 form-select shadow-none"
                                    asp-items="@(new SelectList(Model.AvailableServiceTypes, "Value", "Text"))">
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="custom-input-set mb-2">
                            <label asp-for="SearchStatusId" class="form-label"></label>
                            <select asp-for="SearchStatusId"
                                    class="select2 form-select shadow-none"
                                    asp-items="@(new SelectList(Model.AvailableFormStatus, "Value", "Text"))">
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form-search>

<div id="orders">
    @await Html.PartialAsync("_OrderList.cshtml", Model.Items)
</div>


@section scripts{
    <script>

    </script>
}