@using RA.Core.Models.PluginModels.BusinessEntities

@model BusinessEntityConfigureModel

@Html.HiddenFor(c => c.EntityTypeId)
@Html.HiddenFor(c => c.SystemName)
<div class="form-group">
    <div class="form-check form-check-inline mb-2">
        <label class="form-check-label ml-2">Enabled</label>
        <input asp-for="@Model.Enabled" class="form-check-input" type="checkbox" />
    </div>
    <div class="mb-2">
        <label for="@Model.Template" class="form-label">Template:</label>
        <input asp-for="@Model.Template" type="text" class="form-control" autocomplete="off" />
    </div>
    <div class="mb-2">
        <label for="@Model.TemplateCount" class="form-label">Template Count:</label>
        <input asp-for="@Model.TemplateCount" type="number" class="form-control" autocomplete="off" />
    </div>
    <div class="mb-2">
        <label for="@Model.TemplateIncrementCount" class="form-label">Template Increment:</label>
        <input asp-for="@Model.TemplateIncrementCount" type="number" class="form-control" autocomplete="off" />
    </div>
    <div class="form-check form-check-inline mb-2">
        <label class="form-check-label ml-2">Auto Generated Template</label>
        <input asp-for="@Model.AutoGeneratedTemplate" class="form-check-input" type="checkbox" />
    </div>
</div>