@inject IModelAttributeHelper modelAttributeHelper;
@model WebServiceEndpointListModel

@{
    Layout = null;
}

<div class="card">
    <div class="card-body">
        @{
            // working data table creation
            // just needed to know the arrangement of records for tbody
            var gridTable = new DataTablesModel();
            gridTable.GridName = "webServiceEndpoints_table";
            gridTable.ClassName = "table-dark";
            gridTable.UrlController = "WebServiceEndpoints";
            gridTable.UrlEdit = "Index";
            gridTable.UrlDelete = "Delete";
            gridTable.UrlGridPartialViewAction = "WebServiceEndpointListSearch";
            gridTable.EditEnabled = true;
            gridTable.DeleteEnabled = true;
            gridTable.ConfigurationEnabled = false;

            gridTable.Records = Model.Items;

            gridTable.ColumnCollection = new List<ColumnDefinition>
            {
                new ColumnDefinition(nameof(WebServiceEndpointModel.Id))
                {
                    IsPrimaryKey = true,
                    Visible = false,
                },
                new ColumnDefinition(nameof(WebServiceEndpointModel.EndpointName))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<WebServiceEndpointModel>(nameof(WebServiceEndpointModel.EndpointName)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(WebServiceEndpointModel.EndpointDomain))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<WebServiceEndpointModel>(nameof(WebServiceEndpointModel.EndpointDomain)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(WebServiceEndpointModel.EndpointEntityTypeName))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<WebServiceEndpointModel>(nameof(WebServiceEndpointModel.EndpointEntityTypeName)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(WebServiceEndpointModel.EndpointDescription))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<WebServiceEndpointModel>(nameof(WebServiceEndpointModel.EndpointDescription)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(WebServiceEndpointModel.CreatedOn))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<WebServiceEndpointModel>(nameof(WebServiceEndpointModel.CreatedOn)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(WebServiceEndpointModel.ModifiedOn))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<WebServiceEndpointModel>(nameof(WebServiceEndpointModel.ModifiedOn)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(WebServiceEndpointModel.CreatedByUser))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<WebServiceEndpointModel>(nameof(WebServiceEndpointModel.CreatedByUser)),
                    Visible = true,
                    PropertyValueHolder = nameof(WebServiceEndpointModel.CreatedByUser.FullName),
                },
            };

            @await Html.PartialAsync("~/Views/Shared/Tables/_Table.cshtml", gridTable)
        }
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/Tables/_Pagination.cshtml", Model)

