@inject IModelAttributeHelper modelAttributeHelper;

@model CategoryListModel

@{
    Layout = null;
}

<div class="card">
    <div class="card-body">
        @{
            // working data table creation
            // just needed to know the arrangement of records for tbody
            var gridTable = new DataTablesModel();
            gridTable.GridName = "categories_table";
            gridTable.ClassName = "table-dark";
            gridTable.UrlController = "Categories";
            gridTable.UrlEdit = "Index";
            gridTable.UrlDelete = "Delete";
            gridTable.UrlGridPartialViewAction = "CategoryListSearch";
            gridTable.EditEnabled = true;
            gridTable.DeleteEnabled = true;
            gridTable.ConfigurationEnabled = false;

            gridTable.Records = Model.Items;

            gridTable.ColumnCollection = new List<ColumnDefinition>
            {
                new ColumnDefinition(nameof(CategoryModel.Id))
                {
                    IsPrimaryKey = true,
                    Visible = false,
                },
                new ColumnDefinition(nameof(CategoryModel.Code))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<CategoryModel>(nameof(CategoryModel.Code)),
                    Visible = true,
                    // RedirectUsingCodeEnabled = @Model.UI.RedirectByCodeEnabled
                    // for now value is true
                    RedirectUsingCodeEnabled = true
                },
                new ColumnDefinition(nameof(CategoryModel.Name))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<CategoryModel>(nameof(CategoryModel.Name)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(CategoryModel.Description))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<CategoryModel>(nameof(CategoryModel.Description)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(CategoryModel.CreatedOn))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<CategoryModel>(nameof(CategoryModel.CreatedOn)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(CategoryModel.ModifiedOn))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<CategoryModel>(nameof(CategoryModel.ModifiedOn)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(CategoryModel.Status))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<CategoryModel>(nameof(CategoryModel.StatusId)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(CategoryModel.CreatedByUser))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<CategoryModel>(nameof(CategoryModel.CreatedByUser)),
                    Visible = true,
                    PropertyValueHolder = nameof(CategoryModel.CreatedByUser.FullName),
                },
            };

            @await Html.PartialAsync("~/Views/Shared/Tables/_Table.cshtml", gridTable)
        }
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/Tables/_Pagination.cshtml", Model)

