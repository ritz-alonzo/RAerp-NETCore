@model CategoryModel

<div class="col-md-12">
    <!-- Nav tabs -->
    <ul class="nav nav-tabs" id="formTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="general-form-tab" data-bs-toggle="tab" data-bs-target="#generalForm" type="button" role="tab" aria-controls="generalForm" aria-selected="true">
                @HtmlContentConstants.GeneralTab
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="config-main-tab" data-bs-toggle="tab" data-bs-target="#configMain" type="button" role="tab" aria-controls="configMain" aria-selected="true">
                @HtmlContentConstants.MainTab
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="config-mapping-tab" data-bs-toggle="tab" data-bs-target="#configMapping" type="button" role="tab" aria-controls="configMapping" aria-selected="false">
                @HtmlContentConstants.MappingsTab
            </button>
        </li>
    </ul>
    <div class="tab-content" id="formTabContent">
        <div class="tab-pane fade show active" id="generalForm" role="tabpanel" aria-labelledby="general-form-tab">
            <div class="card">
                <div class="card-body">
                    @await Html.PartialAsync("_CreateAndEdit.General.cshtml", Model)

                    @await Html.PartialAsync("_CreateAndEdit.System.cshtml", Model)
                </div>
            </div>
        </div>
        @foreach (var view in Model.PluginComponents)
        {
            <div class="tab-pane fade" id="configMapping" role="tabpanel" aria-labelledby="config-mapping-tab">
                <div class="card">
                    <div class="card-body">
                        @await Component.InvokeAsync(view.ComponentName, Model)
                    </div>
                </div>
            </div>
        }
    </div>
</div>