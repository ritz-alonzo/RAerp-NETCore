@model CatalogConfigureModel

<div class="form-group">
    <div class="form-check form-check-inline mb-2">
        <label class="form-check-label ml-2">Enabled</label>@*working for testing <span data-required></span>*@
        <input asp-for="@Model.Enabled" class="form-check-input" type="checkbox" />
    </div>
    <div class="custom-input-set mb-2">
        <label for="@Model.Template" class="form-label">Template:</label>
        <input asp-for="@Model.Template" type="text" class="form-control" autocomplete="off" />
    </div>
    <div class="custom-input-set mb-2">
        <label for="@Model.TemplateCount" class="form-label">Template Count:</label>
        <input asp-for="@Model.TemplateCount" type="number" class="form-control" autocomplete="off" />
    </div>
    <div class="custom-input-set mb-2">
        <label for="@Model.TemplateIncrementCount" class="form-label">Template Increment:</label>
        <input asp-for="@Model.TemplateIncrementCount" type="number" class="form-control" autocomplete="off" />
    </div>
    <div class="custom-input-set mb-2">
        <label for="@Model.SKUTemplate" class="form-label">SKU Template:</label>
        <input asp-for="@Model.SKUTemplate" type="text" class="form-control" autocomplete="off" />
        <small class="text-muted">This is Auto Generated based on Template Count & Increment</small>
    </div>
    <div class="custom-input-set mb-2">
        <label for="@Model.BarcodeTemplate" class="form-label">Barcode Template:</label>
        <input asp-for="@Model.BarcodeTemplate" type="text" class="form-control" autocomplete="off" />
        <small class="text-muted">This is Auto Generated based on Template Count & Increment</small>
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label class="form-check-label ml-2">Auto Generated Template</label>
        <input asp-for="@Model.AutoGeneratedTemplate" class="form-check-input" type="checkbox" />
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label class="form-check-label ml-2">Inventory Enabled</label>
        <input asp-for="@Model.InventoryEnabled" class="form-check-input" type="checkbox" />
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label class="form-check-label ml-2">Image Enabled</label>
        <input asp-for="@Model.IsImageEnabled" class="form-check-input" type="checkbox" />
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label class="form-check-label ml-2">SKU Enabled</label>
        <input asp-for="@Model.IsSKUEnabled" class="form-check-input" type="checkbox" />
    </div>
    <div class="form-check form-check-inline col-12 mb-2">
        <label class="form-check-label ml-2">Barcode Enabled</label>
        <input asp-for="@Model.IsBarcodeEnabled" class="form-check-input" type="checkbox" />
    </div>
</div>