@model CatalogSearchModel
@{
    ViewData["Title"] = @Model.EntityTypeName;
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    HtmlActiveNodeMenu.SetActivePluginMenu(Context, Model.EntityTypeSystemName);
}

<div class="float-right">
    <a asp-action="Create" 
    class="btn btn-primary" 
    asp-route-entityTypeId="@Model.SearchEntityTypeId" 
    asp-controller="Catalogs">
    <i class="fa fa-plus"></i> 
    Create
    </a>
</div>
<div class="col-md-9">
    <h2>@Model.EntityTypeName</h2>
</div>
<form-search id="catalogs_search">
    @Html.HiddenFor(c => c.SearchEntityTypeId)
    @Html.HiddenFor(c => c.EntityTypeName)
    @Html.HiddenFor(c => c.PageNumber)
    @Html.HiddenFor(c => c.PageSize)
    @Html.HiddenFor(c => c.TotalItems)
    <div id="search">
        <div class="card">
            <div class="card-header-search">
                <h4 class="text-muted">Search</h4>
            </div>
            <div class="card-body-search">
                 <div class="row">
                    <div class="col-md-6">
                        <div class="custom-input-set mb-2">
                            <label asp-for="SearchQuery" class="form-label"></label>
                            <input asp-for="SearchQuery" class="form-control" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="custom-input-set mb-2">
                            <label asp-for="SearchCreatedOn" class="form-label"></label>
                            <input asp-for="SearchCreatedOn" id="datepicker-autoclose" class="form-control" type="date" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="custom-input-set mb-2">
                            <label asp-for="SearchStatusId" class="form-label"></label>
                            <select asp-for="SearchStatusId"
                                    class="select2 form-select shadow-none"
                                    asp-items="@(new SelectList(Model.AvailableCatalogStatus, "Value", "Text"))">
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form-search>

<div id="catalogs">
    @await Html.PartialAsync("_CatalogList.cshtml", Model.Catalogs)
</div>


@section scripts{
    <script>

    </script>
}