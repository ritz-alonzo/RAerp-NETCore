@model CatalogModel

<div class="col-md-12">
    <!-- Nav tabs -->
    <ul class="nav nav-tabs" id="formTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="general-form-tab" data-bs-toggle="tab" data-bs-target="#generalForm" type="button" role="tab" aria-controls="generalForm" aria-selected="true">
                @HtmlContentConstants.GeneralTab
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="visual-appearance-form-tab" data-bs-toggle="tab" data-bs-target="#visualAppearanceForm" type="button" role="tab" aria-controls="visualAppearanceForm" aria-selected="true">
                @HtmlContentConstants.VisualAppearanceTab
            </button>
        </li>
    </ul>
    <div class="tab-content" id="formTabContent">
        <div class="tab-pane fade show active" id="generalForm" role="tabpanel" aria-labelledby="general-form-tab">
            <div class="card">
                <div class="card-body">
                    @await Html.PartialAsync("_CreateAndEdit.General.cshtml", Model)
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    @await Html.PartialAsync("_CreateAndEdit.System.cshtml", Model)
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="visualAppearanceForm" role="tabpanel" aria-labelledby="visual-appearance-form-tab">
            <div class="card">
                <div class="card-body">
                    @await Html.PartialAsync("_CreateAndEdit.VisualAppearance.cshtml", Model)
                </div>
            </div>
        </div>
    </div>
</div>