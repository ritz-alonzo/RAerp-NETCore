@model BusinessEntityModel

@{
    ViewData["Title"] = string.Format(HtmlContentFormat.PageTitle, Model.EntityTypeName);
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    HtmlActiveNodeMenu.SetActivePluginMenu(Context, Model.EntityTypeSystemName);
}

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(c => c.EntityTypeId)
    <div class="form-content-header-title">
        @{
            <text>@Html.Raw(string.Format(HtmlContentFormat.HeaderTitle, Model.EntityTypeName, Model.Code))</text>
        }
    </div>
    <div class="form-content-header-control">
        <div class="form-content-back-redirection-control">
            <a asp-action="List" asp-route-entityTypeId="@Model.EntityTypeId" asp-controller="BusinessEntities"><i class="fa fa-arrow-left"></i> Back to List</a>
        </div>
        <div>
            <input type="submit" value="Save" class="btn btn-success" />
        </div>
    </div>
    <hr />
    <div class="row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @await Html.PartialAsync("_CreateAndEdit.cshtml", Model)
    </div>
</form>

@section scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

