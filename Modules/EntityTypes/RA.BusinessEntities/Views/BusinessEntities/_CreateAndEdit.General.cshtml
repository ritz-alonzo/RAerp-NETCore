@model BusinessEntityModel

<div class="row">
    <div class="form-content-header-group">
        @HtmlContentConstants.InfoHeader
    </div>
    <div class="custom-input-set col-md-6">
        <label asp-for="@Model.Code" class="form-label" data-required="true"></label>@*working - for testing add data-required=true for fields that are required*@
        <input asp-for="@Model.Code" type="text" class="form-control" autocomplete="off" readonly />
        <span asp-validation-for="@Model.Code" class="text-danger"></span>
    </div>
    <div class="custom-input-set col-md-6">
        <label asp-for="@Model.Name" class="form-label"></label>
        <input asp-for="@Model.Name" type="text" class="form-control" autocomplete="off" />
        <span asp-validation-for="@Model.Name" class="text-danger"></span>
    </div>
    <div class="custom-input-set col-md-6">
        <label asp-for="@Model.Description" class="form-label"></label>
        <input asp-for="@Model.Description" type="text" class="form-control" autocomplete="off" />
        <span asp-validation-for="@Model.Description" class="text-danger"></span>
    </div>
    @* Add Model.UserInterface to show hide Category *@
    <div class="custom-input-set col-md-6">
        <label asp-for="@Model.CategoryId" class="form-label"></label>
        <select asp-for="CategoryId"
                class="select2 form-select shadow-none"
                asp-items="@(new SelectList(Model.AvailableCategories, "Value", "Text"))">
        </select>
        <span asp-validation-for="@Model.CategoryId" class="text-danger"></span>
    </div>
    @if (Model.IsUserMappingEnabled) {
        <div class="custom-input-set col-md-6">
            <label asp-for="@Model.UserId" class="form-label"></label>
            <select asp-for="UserId"
                    class="select2 form-select shadow-none"
                    asp-items="@(new SelectList(Model.AvailableUsers, "Value", "Text"))">
            </select>
            <span asp-validation-for="@Model.UserId" class="text-danger"></span>
        </div>
    }
</div>