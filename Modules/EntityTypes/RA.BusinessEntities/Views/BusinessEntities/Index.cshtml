@model BusinessEntityModel

@{
    ViewData["Title"] = Model.EntityTypeName;
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    HtmlActiveNodeMenu.SetActivePluginMenu(Context, Model.EntityTypeSystemName);
}

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(c => c.EntityTypeId)
    @Html.HiddenFor(c => c.Id)
    <div class="col-md-12"><h2>@Model.Code - @Model.Name</h2></div>
    <div class="col-12">
        <div class="float-right">
            <input type="submit" value="Save" class="btn btn-success" />
        </div>
        <div class="float-left">
            <a asp-action="List" asp-route-entityTypeId="@Model.EntityTypeId" asp-controller="BusinessEntities" ><i class="fa fa-arrow-left"></i> Back to List</a>
        </div>
    </div>
    <br />
    <br />
    <hr />
    <div class="row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @await Html.PartialAsync("_CreateAndEdit.cshtml", Model)
    </div>
</form>

@section scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

