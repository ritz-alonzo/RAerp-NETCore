@model BusinessEntityModel

<div class="col-md-12">
    <div class="card">
        <!-- Nav tabs -->
        <ul class="nav nav-tabs" id="formTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active"id="general-form-tab" data-bs-toggle="tab" data-bs-target="#generalForm" type="button" role="tab" aria-controls="generalForm" aria-selected="true">
                    @HtmlContentConstants.GeneralTab
                </button>
            </li>
            @if (Model.AddressEnabled)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="address-form-tab" data-bs-toggle="tab" data-bs-target="#addressForm" type="button" role="tab" aria-controls="addressForm" aria-selected="false">
                        @HtmlContentConstants.AddressTab
                    </button>
                </li>
            }
        </ul>
        <div class="tab-content" id="formTabContent">
            <div class="tab-pane fade show active" id="generalForm" role="tabpanel" aria-labelledby="general-form-tab">
                <div class="card-body">
                    @await Html.PartialAsync("~/Plugins/RA.BusinessEntities/Views/_CreateAndEdit.General.cshtml", Model)

                    @await Html.PartialAsync("~/Plugins/RA.BusinessEntities/Views/_CreateAndEdit.System.cshtml", Model)
                </div>
            </div>
            <div class="tab-pane fade" id="addressForm" role="tabpanel" aria-labelledby="address-form-tab">
                <div class="card-body">
                    @await Html.PartialAsync("~/Plugins/RA.BusinessEntities/Views/_CreateAndEdit.Address.cshtml", Model)
                </div>
            </div>
        </div>
    </div>
</div>