@model InventoryConfigureModel

@{
    ViewData["Title"] = "Inventory";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    HtmlActiveNodeMenu.SetActivePluginMenu(Context, Model.SystemName);
}

<form asp-action="Configuration" method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(c => c.SystemName)
    <div class="form-content-header-title">
        @{
            <text>@Html.Raw(string.Format(HtmlContentFormat.PageTitle, "Inventory Settings"))</text>
        }
    </div>
    <div class="form-content-header-control">
        <div>
            <input type="submit" value="Save" class="btn btn-success" />
        </div>
    </div>
    <hr />
    <div class="row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-md-12">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" id="formTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="general-form-tab" data-bs-toggle="tab" data-bs-target="#generalForm" type="button" role="tab" aria-controls="generalForm" aria-selected="true">
                        @HtmlContentConstants.GeneralTab
                    </button>
                </li>
            </ul>
            <div class="tab-content" id="formTabContent">
                <div class="tab-pane fade show active" id="generalForm" role="tabpanel" aria-labelledby="general-form-tab">
                    <div class="card">
                        <div class="card-body">
                            <div class="row">
                                <div class="form-content-header-group">
                                    @HtmlContentConstants.InfoHeader
                                </div>
                                <div class="form-group">
                                    <div class="form-check form-check-inline mb-2">
                                        <label class="form-check-label ml-2">Enabled</label>@*working for testing <span data-required></span>*@
                                        <input asp-for="@Model.IsEnabled" class="form-check-input" type="checkbox" />
                                    </div>
                                    <div class="custom-input-set col-md-6">
                                        <div class="mb-2">Catalog Types:</div>
                                        <select asp-for="MappedCatalogTypeIds"
                                                class="multi-select form-control"
                                                multiple="multiple"
                                                asp-items="@(new SelectList(Model.AvailableCatalogTypes, "Value", "Text"))">
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        $(document).ready(() => {
            $('#MappedCatalogTypeIds').multiselect({
                includeSelectAllOption: true,
                templates: {
                    button: '<button type="button" class="multiselect dropdown-toggle btn btn-primary" data-toggle="dropdown" aria-expanded="false" id="selectCatalogTypeIdsBtn"><span class="multiselect-selected-text"></span></button>',
                },
            });
            $('#selectCatalogTypeIdsBtn').on('click', (e) => {
                console.log('multi select button clicked');
                var multiSelectContainer = $('ul.multiselect-container');
                if (multiSelectContainer != undefined || multiSelectContainer != null) {
                    if (multiSelectContainer.css('display') == 'flex') {
                        multiSelectContainer.css('display', 'none');
                    }
                    else {
                        multiSelectContainer.css('display', 'flex');
                    }
                }
            });
        });
    </script>
}



