@using Microsoft.AspNetCore.Http;
@using RAerp.Helpers.UserHelper;
@inject IUserIdentity userIdentity
@{
    var appDetails = applicationDetails.GetApplicationDetails();
    var currentUser = userIdentity.GetCurrentUserAsync(Context).Result;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RAerp</title>
    @* <link rel="stylesheet" type="text/css" href="~/lib/bootstrap/dist/css/bootstrap.css" /> *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/admin.style.css" rel="stylesheet" />
    <link href="~/css/sidebar.style.css" rel="stylesheet" />
    <!-- Custom CSS -->
    @* <link href="~/assets/libs/flot/css/float-chart.css" rel="stylesheet" /> *@
    <!-- Custom CSS -->
    @* <link href="~/css/style.min.css" rel="stylesheet" /> *@
    <!-- Font Awesome CSS -->
    <link href="~/css/font-awesome/css/fontawesome.min.css" rel="stylesheet" />
    <link href="~/css/font-awesome/css/fontawesome-all.css" rel="stylesheet" />
    <link href="~/assets/libs/toastr/build/toastr.min.css" rel="stylesheet" />
    <link rel="icon" href="~/rlogo.svg" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/0.9.14/css/bootstrap-multiselect.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
</head>
<body>
    <!-- Overlay (mobile backdrop) -->
    <div id="overlay" onclick="closeMobile()"></div>
 
    <!-- ── SIDEBAR ── -->
    <aside id="sidebar">
        <!-- Brand -->
        <a href="#" class="sidebar-brand">
            <div class="brand-icon"><i class="fas fa-layer-group"></i></div>
            <span class="brand-name">@appDetails.ApplicationName</span>
        </a>
 
        <!-- Nav -->
        <nav class="sidebar-nav">
 
            <div class="nav-section-label">Main</div>
            <a href="@Url.Action("Index","Home")" class="nav-item-link active" data-label="Dashboard">
                <i class="fas fa-th-large nav-icon"></i>
                <span class="nav-label">Dashboard</span>
            </a>
            <!-- Admin Menu in Sidebar -->
            @await Html.PartialAsync("~/Views/Shared/Sidebars/_SideBarAdminMenu.cshtml")
            <div class="nav-section-label" style="margin-top:8px;">Plugins</div>
            <!-- Plugin Menu in Sidebar -->
            @await Html.PartialAsync("~/Views/Shared/Sidebars/_SideBarPluginMenu.cshtml")
 
            <!-- Help — plain link -->
            <div class="nav-section-label" style="margin-top:8px;">System</div>
            <a href="#" class="nav-item-link" data-label="Help">
                <i class="fas fa-question-circle nav-icon"></i>
                <span class="nav-label">Help & Docs</span>
            </a>
 
        </nav>
 
        <!-- User footer -->
        @if (currentUser != null)
        {
            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <div class="user-avatar">@currentUser.FirstName?.Substring(0, 1)@currentUser.LastName?.Substring(0, 1)</div>
                    <div class="user-info">
                        <div class="user-name">@currentUser.FirstName @currentUser.LastName</div>
                        @* <div class="user-role">@currentUser.Rol</div> *@
                    </div>
                </div>
            </div>
        }
    </aside>
    <!-- ── TOPBAR ── -->
    <header id="topbar">
        <!-- Desktop toggle -->
        <button class="toggle-btn d-none d-md-flex" id="desktopToggle" aria-label="Toggle sidebar" onclick="toggleDesktop()">
            <i class="fas fa-bars"></i>
        </button>
 
        <!-- Mobile toggle -->
        <button class="toggle-btn d-flex d-md-none" aria-label="Open sidebar" onclick="openMobile()">
            <i class="fas fa-bars"></i>
        </button>
 
        <!-- Search -->
        <div class="topbar-search d-none d-sm-block">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Search anything…" />
        </div>
 
        <div class="topbar-actions">
            <p class="dashboard-time" style="font-size:13px; color:#9198ab; margin:2px 0 0; font-family:'DM Mono',monospace;"></p>
            <div class="icon-btn" title="Notifications">
                <i class="fas fa-bell"></i>
                <span class="notif-dot"></span>
            </div>
            <div class="icon-btn" title="Theme">
                <i class="fas fa-moon"></i>
            </div>
            @if (currentUser != null)
            {
                <li class="nav-item dropdown">
                    <a class="user-avatar nav-link dropdown-toggle" href="#" id="navbarUserDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="cursor:pointer; width:34px; height:34px; font-size:12px;">@currentUser.FirstName?.Substring(0, 1)@currentUser.LastName?.Substring(0, 1)</a>
                    <ul class="dropdown-menu" aria-labelledby="navbarUserDropdownMenuLink">
                        <li><a class="dropdown-item" href="@Url.Action("Profile", "Users", new { id = currentUser?.Id })">Profile</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("ChangePassword", "Users", new { id = currentUser?.Id })">Change Password</a></li>
                        <hr/>
                        <li><a class="dropdown-item" href="@Url.Action("Logout", "Users")"><i class="fa fa-power-off me-1 ms-1"></i> Logout</a></li>
                    </ul>
                </li>
            }
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>
    <footer class="footer text-end text-muted">
        &copy; 2024 - RAerp - <a asp-area="" asp-controller="Home" asp-action="Privacy">@appDetails.Version</a>
    </footer>
    @* </div> *@

    <script src="~/assets/libs/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap tether Core JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/assets/libs/toastr/toastr.js"></script>
    <script src="~/js/admin.js"></script>
    <script src="~/js/address.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/0.9.13/js/bootstrap-multiselect.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.30.1/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script type="text/javascript">
        @if (TempData.ContainsKey("notificationScript") && TempData.ContainsKey("notificationMessage"))
        {
            var jsFunction = TempData["notificationScript"]?.ToString();
            var message = TempData["notificationMessage"]?.ToString();
            if (!string.IsNullOrEmpty(jsFunction))
            {
                <text>
                    var notifFunction = @Html.Raw(Json.Serialize(jsFunction));
                    var notifMessage = @Html.Raw(Json.Serialize(message));
                    initializeControllerNotification(notifFunction, notifMessage);
                </text>
            }
        }

    </script>
    <script type="text/javascript">
        $('#formItemModal').on('hidden.bs.modal', (e) => {
            console.log('hiding modal');
            $('#formItemData').html("");
            $('#formItemModalLabel').html("");
        });

        const sidebar = document.getElementById('sidebar');
        const topbar  = document.getElementById('topbar');
        const mainEl  = document.getElementById('main');
        const overlay = document.getElementById('overlay');

        /* ── Sidebar collapse (desktop) ── */
        function toggleDesktop() {
            const wasCollapsed = sidebar.classList.contains('collapsed');
            sidebar.classList.toggle('collapsed');
            const isCollapsed = sidebar.classList.contains('collapsed');
            topbar.style.left     = isCollapsed ? 'var(--sidebar-collapsed-width)' : 'var(--sidebar-width)';
            mainEl.style.marginLeft = isCollapsed ? 'var(--sidebar-collapsed-width)' : 'var(--sidebar-width)';
            // close all dropdowns when collapsing
            if (isCollapsed) closeAllDropdowns();
        }
 
        /* ── Mobile ── */
        function openMobile() {
            sidebar.classList.add('mobile-open');
            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        function closeMobile() {
            sidebar.classList.remove('mobile-open');
            overlay.classList.remove('active');
            document.body.style.overflow = '';
        }
 
        /* ── Dropdown helpers ── */
        function closeAllDropdowns(except) {
        document.querySelectorAll('.nav-dropdown-toggle.open').forEach(btn => {
            if (btn === except) return;
                btn.classList.remove('open');
                btn.nextElementSibling.classList.remove('open');
            });
        }
 
        function openDropdown(toggle, menu) {
        // If sidebar is collapsed, expand it first
        if (sidebar.classList.contains('collapsed')) {
            sidebar.classList.remove('collapsed');
            topbar.style.left     = 'var(--sidebar-width)';
            mainEl.style.marginLeft = 'var(--sidebar-width)';
        }
            closeAllDropdowns(toggle);
            toggle.classList.add('open');
            menu.classList.add('open');
        }
 
        /* ── Wire up dropdown toggles (accordion) ── */
        document.querySelectorAll('.nav-dropdown-toggle').forEach(toggle => {
        const menu = toggle.nextElementSibling;
        toggle.addEventListener('click', () => {
                if (toggle.classList.contains('open')) {
                    toggle.classList.remove('open');
                    menu.classList.remove('open');
                } else {
                    openDropdown(toggle, menu);
                }
            });
        });
 
        /* ── Plain nav-item-link active state ── */
        document.querySelectorAll('.nav-item-link').forEach(link => {
            link.addEventListener('click', function(e) {
                document.querySelectorAll('.nav-item-link').forEach(l => l.classList.remove('active'));
                document.querySelectorAll('.nav-sub-item').forEach(l => l.classList.remove('active'));
                this.classList.add('active');
                closeAllDropdowns();
                if (window.innerWidth < 768) closeMobile();
            });
        });
 
        /* ── Sub-item active state ── */
        document.querySelectorAll('.nav-sub-item').forEach(item => {
            item.addEventListener('click', function(e) {
                document.querySelectorAll('.nav-sub-item').forEach(l => l.classList.remove('active'));
                document.querySelectorAll('.nav-item-link').forEach(l => l.classList.remove('active'));
                this.classList.add('active');
                var menu = $(this).parent(".nav-dropdown-menu");
                var toggle = menu.prev(".nav-dropdown-toggle");
                openDropdown(toggle, menu);
                if (window.innerWidth < 768) closeMobile();
            });
        });
        $(document).ready(() => {
            function updateTime() {
                var now = new Date();
                var dateNow = now.toLocaleDateString();
                var timeNow = now.toLocaleTimeString();
                $('.dashboard-time').html(dateNow + " - " + timeNow);
            }
            updateTime();
            setInterval(updateTime, 1000);
        });
    </script>
    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
