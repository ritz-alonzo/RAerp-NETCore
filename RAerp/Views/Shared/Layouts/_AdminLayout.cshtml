    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/0.9.13/js/bootstrap-multiselect.js"></script>
    
    <script>
        var jsFunction = '';
        var message = '';
        @if (TempData.ContainsKey("notificationScript") && TempData.ContainsKey("notificationMessage"))
        {
            <text>
                jsFunction = '@TempData["notificationScript"]'
                message = '@TempData["notificationMessage"]'
            </text>
        }
        if (jsFunction != null || jsFunction != "" || jsFunction != '') {
            initializeControllerNotification(jsFunction, message);
        }
    </script>

    @await RenderSectionAsync("scripts", required: false)
