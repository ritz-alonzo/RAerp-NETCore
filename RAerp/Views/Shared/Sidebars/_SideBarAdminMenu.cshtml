@using RAerp.Services.PluginNavigationServices;
@using RAerp.Helpers.HtmlHelper;
@inject INavigationService navigationService;

@{
    // TODO: Setting Active menu system
    var selectedMenuSystemName = HtmlActiveNodeMenu.GetActivePluginMenu(Context);
    var selectedMenuController = HtmlActiveNodeMenu.GetActivePluginMenuController(Context);

    var pluginNodes = await navigationService.GetAdminNodesMenu(Context);

    foreach (var node in pluginNodes.OrderBy(c => c.DisplayOrder))
    {
        if (node.Visible)
        {
            var hasRelatedNodes = node.RelatedNodes.Count > 0;
            if (hasRelatedNodes)
            {
                <div class="nav-group">
                    <button class="nav-dropdown-toggle @if(selectedMenuController == node.MenuTitle.Replace(" ", "")) {<text>open</text>}" data-label="@node.MenuTitle">
                        <i class="@node.IconClass nav-icon"></i>
                        <span class="nav-label">@node.MenuTitle</span>
                        <i class="fas fa-chevron-down nav-chevron"></i>
                    </button>
                    <div class="nav-dropdown-menu @if(selectedMenuController == node.MenuTitle.Replace(" ", "")) {<text>open</text>}">
                        @foreach (var relatedNode in node.RelatedNodes.OrderBy(c => c.DisplayOrder))
                        {
                            @if (!string.IsNullOrEmpty(relatedNode.Url) && relatedNode.Visible)
                            {
                                <a href="@relatedNode.Url" class="nav-sub-item @if (relatedNode.SystemName == selectedMenuSystemName) { <text>active</text> }"><i class="@relatedNode.IconClass" nav-icon></i> @relatedNode.MenuTitle</a>
                            }
                        }
                    </div>
                </div>
            }
            else
            {
                <a href="@node.Url" class="nav-item-link @if (selectedMenuSystemName == node.SystemName.Replace(" ", "")) { <text>active</text> }" data-label="@node.MenuTitle">
                    <i class="@node.IconClass nav-icon"></i>
                    <span class="nav-label">@node.MenuTitle</span>
                </a>
            }
            // Main node
            // <div class="nav-group">
