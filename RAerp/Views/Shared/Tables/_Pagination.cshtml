<div class="table-footer">
    <span class="footer-info" id="footerInfo">Showing: @Model.Items.Count</span>
    <div class="page-btns">
            @if (Model.PageNumber > 1)
            {
                <a class="pg" href="?page=@(Model.PageNumber - 1)&pageSize=@Model.PageSize"><i class="fas fa-chevron-left" style="font-size:10px"></i></a>
            }

            @for (int i = 1; i <= Model.TotalItems; i++)
            {
                <a class="pg @(i == Model.PageNumber ? "active" : "")" href="?page=@i&pageSize=@Model.PageSize">@i</a>
            }

            @if (Model.PageNumber < Model.TotalItems)
            {
                <a class="pg" href="?page=@(Model.PageNumber + 1)&pageSize=@Model.PageSize"><i class="fas fa-chevron-right" style="font-size:10px"></i></a>
            }
    </div>
</div>