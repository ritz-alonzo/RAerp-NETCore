<div class="row">
    <div class="col-md-6">
        <h4 class="text-muted">Total records shown: @Model.Items.Count</h4>
    </div>
    <div class="col-md-6">
        <nav aria-label="Page navigation" class="float-right">
            <ul class="pagination">
                @if (Model.PageNumber > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=@(Model.PageNumber - 1)&pageSize=@Model.PageSize">Previous</a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalItems; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="?page=@i&pageSize=@Model.PageSize">@i</a>
                    </li>
                }

                @if (Model.PageNumber < Model.TotalItems)
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=@(Model.PageNumber + 1)&pageSize=@Model.PageSize">Next</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>