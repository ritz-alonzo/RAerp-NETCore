@model UserModel

@{
    ViewData["Title"] = string.Format(HtmlContentFormat.PageTitle, "Verify Account");
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    HtmlActiveNodeMenu.SetActivePluginMenu(Context, Model.SystemName);
}

<form asp-action="VerifyAccount" method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(c => c.Id)
    <div class="form-content-header-title">
        @{
            <text>@Html.Raw(string.Format(HtmlContentFormat.HeaderTitle, "Verify Account", Model.FirstName + " " + Model.LastName))</text>
        }
    </div>
    <div class="form-content-header-control">
        <div class="content-back-redirection-control">
            <a asp-action="List" asp-controller="Users"><i class="fa fa-arrow-left"></i> Back to List</a>
        </div>
        <div>
            <input type="button" value="Resend OTP" class="btn btn-secondary" onclick="resendOTP('@Model.Id')"/>
            <input type="submit" value="Verify" class="btn btn-success" />
        </div>
    </div>
    <hr />
    <div class="row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-md-12">
            <div class="card">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs" id="formTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="general-form-tab" data-bs-toggle="tab" data-bs-target="#generalForm" type="button" role="tab" aria-controls="generalForm" aria-selected="true">
                            Verify Account
                        </button>
                    </li>
                </ul>
                <div class="tab-content" id="formTabContent">
                    <div class="tab-pane fade show active" id="generalForm" role="tabpanel" aria-labelledby="general-form-tab">
                        <div class="card-body">
                            <div class="row">
                                <div class="form-content-header-group">
                                    <i class="fa fa-info-circle"></i> @HtmlContentConstants.InfoHeader
                                </div>
                                <div class="custom-input-set col-md-6">
                                    <label asp-for="@Model.Email" class="form-label" data-required="true"></label>@*working - for testing add data-required=true for fields that are required*@
                                    <input asp-for="@Model.Email" type="text" class="form-control" autocomplete="off" />
                                    <span asp-validation-for="@Model.Email" class="text-danger"></span>
                                </div>
                                <div class="custom-input-set col-md-6">
                                    <label asp-for="@Model.OneTimePIN" class="form-label" data-required="true"></label>@*working - for testing add data-required=true for fields that are required*@
                                    <input asp-for="@Model.OneTimePIN" type="text" class="form-control" autocomplete="off" />
                                    <span asp-validation-for="@Model.OneTimePIN" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    @*<div class="tab-pane fade" id="configMapping" role="tabpanel" aria-labelledby="config-mapping-tab">
                    @await Html.PartialAsync("~/Plugins/RA.BusinessEntities/Views/_Configuration.Mapping.cshtml", Model)
                    </div>*@
                </div>
            </div>
        </div>
    </div>
</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function resendOTP(id) {
            if (id === null || id === "") {
                console.error("Id doesn't have value");
                return;
            }

            $.ajax({
                url: '@Url.Action("ResendOTPEmail", "Users")',
                type: 'POST',
                data: {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success === false) {
                        console.log(response.message || 'Error deleting application setting');
                    } 
                    // else {
                    //     window.location.href = '@Url.Action("Index", "Home")';
                    // }
                },
                error: function () {
                    alert('Error deleting application setting');
                }
            })
        }
    </script>
}

