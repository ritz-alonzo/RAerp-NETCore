@model UserModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/Layouts/_Layout.cshtml";
}
@Html.AntiForgeryToken()

@* <h1>Login</h1> *@

<div class="login-form-container">
    <div class="login-form-logo">
        <i class="fa fa-cube"></i>
    </div>
    <div class="login-form-title">
        Sign In
    </div>
    <div class="card">
        <div class="card-body">
            <div class="col-md-12">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    @if (!string.IsNullOrEmpty(ViewBag.Error))
                    {
                        <div class='alert alert-danger col-lg-12' style="text-align:center">
                            @Html.Raw(ViewBag.Error)
                        </div>
                    }
                    <div class="login-form-group">
                        <input asp-for="Username" class="login-form-control" autocomplete="off" />
                        <label asp-for="Username" class="login-form-label-username"></label>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="login-form-group">
                        <input asp-for="Password" type="password" class="login-form-control" autocomplete="off" />
                        <label asp-for="Password" class="login-form-label-password"></label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="login-form-group">
                        <input type="submit" value="Sign in" class="btn btn-primary login-form-button" />
                    </div>
                    <div class="login-form-social-header">
                        <div class="line"></div>
                        <div class="login-form-social-label">Login using Social Accounts</div>
                        <div class="line"></div>
                    </div>
                    <div class="login-form-social">
                        <a href="#" title="Google Login"><i class="fa fa-google"></i></a>
                        <a href="#" title="Facebook Login"><i class="fa fa-facebook"></i></a>
                        <a href="#" title="Github Login"><i class="fa fa-github"></i></a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

