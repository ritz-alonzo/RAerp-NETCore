@model UserModel

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/Layouts/_Layout.cshtml";
}
@Html.AntiForgeryToken()
<div>
    <a asp-action="List" asp-controller="Users"><i class="fa fa-arrow-alt-circle-left"></i> Back to List</a>
</div>
<hr />
<div class="row justify-content-center">
    <div class="col-md-6">
        <form asp-action="Register" method="post">
            <div class="card">
                <div class="card-header">
                    <h4 class="text-muted text-center">Register User</h4>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    @if (!string.IsNullOrEmpty(ViewBag.Error))
                    {
                        <div class='alert alert-danger col-lg-12' style="text-align:center">
                            @Html.Raw(ViewBag.Error)
                        </div>
                    }
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="fa fa-user"></i></span>
                            </div>
                            <input asp-for="FirstName" class="form-control" placeholder="First Name" />
                        </div>
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="fa fa-user"></i></span>
                            </div>
                            <input asp-for="LastName" class="form-control" placeholder="Last Name" />
                        </div>
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            </div>
                            <input asp-for="Email" class="form-control" placeholder="Email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="fa fa-user"></i></span>
                            </div>
                            <input asp-for="Username" class="form-control" placeholder="Username" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-append">
                                 <span class="input-group-text"><i class="fa fa-lock"></i></span>
                            </div>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="fa fa-user-circle"></i></span>
                            </div>
                            <select asp-for="UserRoleId"
                                    class="select2 form-select shadow-none"
                                    asp-items="@(new SelectList(Model.AvailableUserRoles, "Value", "Text"))">
                            </select>
                        </div>
                        <span asp-validation-for="UserRoleId" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="row justify-content-center">
                        <input type="submit" value="Create New User" class="btn btn-primary" />
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

