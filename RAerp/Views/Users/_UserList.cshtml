        //    var url = '@Url.Action("UserListSearch", "Users")'
        //    var partialViewId = 'users';
        //    SearchFunction(formSearchId, url, partialViewId);
        //}
        // else do nothing
    });
    var tableId = "user_table";
    formatStatus(tableId);

</script>



