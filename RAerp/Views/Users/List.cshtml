@model UserSearchModel
@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    HtmlActiveNodeMenu.SetActivePluginMenu(Context, Model.SystemName);
}

<div class="common-content-header-title">
    <div>Users</div>
    <a asp-action="Create" class="btn btn-primary" asp-controller="Users"><i class="fa fa-plus"></i> @HtmlContentConstants.Create</a>
</div>

<form-search id="user_search">
    @Html.HiddenFor(c => c.PageNumber)
    @Html.HiddenFor(c => c.PageSize)
    @Html.HiddenFor(c => c.TotalItems)
    <div id="search">
        <div class="card">
            <div class="card-header-search">
                <h4 class="text-muted">Search</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="input-group">
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="fa fa-search"></i></span>
                            </div>
                            <input asp-for="SearchQuery" class="form-control" placeholder="Search.." autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Date: </span>
                            </div>
                            <input asp-for="SearchCreatedOn" id="datepicker-autoclose" class="form-control" type="date" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form-search>

<div id="users">
    @await Html.PartialAsync("~/Views/Users/_UserList.cshtml", Model.Users)
    @* <partial name="_UserList" model="Model.Users" /> *@
</div>

@section scripts{
    <script>

    </script>
}