@model UserModel

@{
    ViewData["Title"] = string.Format(HtmlContentFormat.PageTitle, "Profile");
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    HtmlActiveNodeMenu.SetActivePluginMenu(Context, Model.SystemName);
}

<form asp-action="Profile" method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(c => c.Id)
    @Html.HiddenFor(c => c.Password)
    <div class="form-content-header-title">
        @{
            <text>@Html.Raw(string.Format(HtmlContentFormat.HeaderTitle, "Profile", Model.FirstName + " " + Model.LastName))</text>
        }
    </div>
    <div class="form-content-header-control">
        <div class="content-back-redirection-control">
            <a asp-action="List" asp-controller="Users"><i class="fa fa-arrow-left"></i> Back to List</a>
        </div>
        <div>
            <input type="submit" value="Save" class="btn btn-success" />
            @if (Model.AccountStatus == RA.Data.Data.UserAccountStatus.Active)
            {
                <a asp-action="ChangePassword" asp-controller="Users" asp-route-id="@Model.Id" class="btn btn-primary">Change Password</a>
            }
            else if (Model.AccountStatus == RA.Data.Data.UserAccountStatus.Pending)
            {
                <a asp-action="VerifyAccount" asp-controller="Users" asp-route-id="@Model.Id" class="btn btn-secondary">Verify Account</a>
            }
        </div>
    </div>
    <hr />
    <div class="row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-md-12">
            <div class="card">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs" id="formTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="general-form-tab" data-bs-toggle="tab" data-bs-target="#generalForm" type="button" role="tab" aria-controls="generalForm" aria-selected="true">
                            @HtmlContentConstants.GeneralTab
                        </button>
                    </li>
                </ul>
                <div class="tab-content" id="formTabContent">
                    <div class="tab-pane fade show active" id="generalForm" role="tabpanel" aria-labelledby="general-form-tab">
                        <div class="card-body">
                            <div class="row">
                                <div class="form-content-header-group">
                                    <i class="fa fa-info-circle"></i> @HtmlContentConstants.InfoHeader
                                </div>
                                <div class="custom-input-set col-md-6">
                                    <label asp-for="@Model.FirstName" class="form-label" data-required="true"></label>@*working - for testing add data-required=true for fields that are required*@
                                    <input asp-for="@Model.FirstName" type="text" class="form-control" autocomplete="off" />
                                    <span asp-validation-for="@Model.FirstName" class="text-danger"></span>
                                </div>
                                <div class="custom-input-set col-md-6">
                                    <label asp-for="@Model.LastName" class="form-label"></label>
                                    <input asp-for="@Model.LastName" type="text" class="form-control" autocomplete="off" />
                                    <span asp-validation-for="@Model.LastName" class="text-danger"></span>
                                </div>
                                <div class="custom-input-set col-md-6">
                                    <label asp-for="@Model.Username" class="form-label"></label>
                                    <input asp-for="@Model.Username" type="text" class="form-control" autocomplete="off" />
                                    <span asp-validation-for="@Model.Username" class="text-danger"></span>
                                </div>
                                <div class="custom-input-set col-md-6">
                                    <label asp-for="@Model.Email" class="form-label"></label>
                                    <input asp-for="@Model.Email" type="email" class="form-control" autocomplete="off" />
                                    <span asp-validation-for="@Model.Email" class="text-danger"></span>
                                </div>
                                <div class="custom-input-set col-md-6">
                                    <label asp-for="@Model.UserRoleId" class="form-label"></label>
                                    <select asp-for="UserRoleId"
                                            class="select2 form-select shadow-none"
                                            asp-items="@(new SelectList(Model.AvailableUserRoles, "Value", "Text"))">
                                    </select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-content-header-group">
                                    <i class="fa fa-cogs"></i> @HtmlContentConstants.SystemHeader
                                </div>
                                <div class="custom-input-set col-md-6">
                                    <label asp-for="@Model.CreatedByUser.FullName" class="form-label"></label>
                                    <input asp-for="@Model.CreatedByUser.FullName" type="text" class="form-control" autocomplete="off" readonly />
                                    <span asp-validation-for="@Model.CreatedByUser.FullName" class="text-danger"></span>
                                </div>
                                <div class="custom-input-set col-md-6">
                                    <label asp-for="@Model.CreatedOn" class="form-label"></label>
                                    <input asp-for="@Model.CreatedOn" type="date" id="datepicker-autoclose" class="form-control" autocomplete="off" readonly />
                                    <span asp-validation-for="@Model.CreatedOn" class="text-danger"></span>
                                </div>
                                <div class="custom-input-set col-md-6">
                                    <label asp-for="@Model.ModifiedOn" class="form-label"></label>
                                    <input asp-for="@Model.ModifiedOn" type="date" id="datepicker-autoclose" class="form-control" autocomplete="off" readonly />
                                    <span asp-validation-for="@Model.ModifiedOn" class="text-danger"></span>
                                </div>
                                <div class="custom-input-set col-md-6">
                                    <label asp-for="@Model.AccountStatus" class="form-label"></label>
                                    <input asp-for="@Model.AccountStatus" type="text" class="form-control" autocomplete="off" readonly />
                                    <span asp-validation-for="@Model.AccountStatus" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    @*<div class="tab-pane fade" id="configMapping" role="tabpanel" aria-labelledby="config-mapping-tab">
                    @await Html.PartialAsync("~/Plugins/RA.BusinessEntities/Views/_Configuration.Mapping.cshtml", Model)
                    </div>*@
                </div>
            </div>
        </div>
    </div>
</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

