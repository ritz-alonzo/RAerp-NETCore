@model RAerp.Models.ApplicationSettingsModel.ApplicationSettingModel

<form asp-action="@(Model.Id == Guid.Empty ? "Create" : "Edit")" asp-controller="ApplicationSettings" method="post">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @if (Model.Id != Guid.Empty)
        {
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ClientId" />
            <input type="hidden" asp-for="ClientSecret" />
        }

        @* <div class="form-group">
            <label asp-for="ApplicationName" class="control-label"></label>
            <input asp-for="ApplicationName" class="form-control" placeholder="Enter application name" />
            <span asp-validation-for="ApplicationName" class="text-danger"></span>
        </div> *@

        <div class="form-group">
            <label asp-for="Description" class="control-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter description (optional)"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <div class="custom-control custom-switch">
                <input type="checkbox" class="custom-control-input" asp-for="IsActive" id="isActiveSwitch" />
                <label class="custom-control-label" for="isActiveSwitch" asp-for="IsActive"></label>
            </div>
            <small class="form-text text-muted">
                Inactive applications will not be able to authenticate with the API.
            </small>
        </div>
    </div>

    <div class="card-footer">
        <button type="submit" class="btn btn-primary">
            <i class="fa fa-save"></i> Save
        </button>
        <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
            <i class="fa fa-times"></i> Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}