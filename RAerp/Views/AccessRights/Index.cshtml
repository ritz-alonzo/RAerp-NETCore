@model AccessRightsSearchModel

@{
    ViewData["Title"] = "Access Rights Control";
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    HtmlActiveNodeMenu.SetActivePluginMenu(Context, Model.SystemName);
}

<div class="common-content-header-title">
    <div>Access Rights Control</div>
</div>

<form-search id="accessRights_search">
    @Html.HiddenFor(c => c.PageNumber)
    @Html.HiddenFor(c => c.PageSize)
    @Html.HiddenFor(c => c.TotalItems)
    <div id="search">
        <div class="card">
            <div class="card-header-search">
                <h4 class="text-muted">Search</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="input-group">
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="fa fa-search"></i></span>
                            </div>
                            <input asp-for="SearchRoleName" class="form-control" placeholder="Search Role.." autocomplete="off" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form-search>

<div id="accessRights">
    @await Html.PartialAsync("~/Views/AccessRights/_AccessRightsList.cshtml", Model.AccessRightsList)
    @* <partial name="_UserList" model="Model.Users" /> *@
</div>

@section scripts {
    <script>

    </script>
}

