@using RA.Core.Models.PluginModels.EntityTypes
@using RAerp.Helpers.HtmlHelper;

@model EntityTypeSearchModel
@{
    ViewData["Title"] = Model.EntityTypeName;
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    HtmlActiveNodeMenu.SetActivePluginMenu(Context, Model.EntityTypeSystemName);
}

<div class="col-md-9">
    <h2>@Model.EntityTypeName</h2>
</div>
<form-search id="entityTypes_search">
    @Html.HiddenFor(c => c.PageNumber)
    @Html.HiddenFor(c => c.PageSize)
    @Html.HiddenFor(c => c.TotalItems)
    <div id="search">
        <div class="card">
            <div class="card-header-search">
                <h4 class="text-muted">Search</h4>
            </div>
            <div class="card-body-search">
                 <div class="row">
                    <div class="col-md-6">
                        <div class="custom-input-set mb-2">
                            <label asp-for="SearchQuery" class="form-label"></label>
                            <input asp-for="SearchQuery" class="form-control" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="custom-input-set mb-2">
                            <label asp-for="SearchInstalledOn" class="form-label"></label>
                            <input asp-for="SearchInstalledOn" id="datepicker-autoclose" class="form-control" type="date" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form-search>

<div id="entityTypes">
    @await Html.PartialAsync("~/Plugins/RA.EntityTypes/Views/_EntityTypeList.cshtml", Model.EntityTypes)
    @*<partial name="_EntityTypeList" model="@Model.EntityTypes" />*@
</div>


@section scripts{
    <script>

    </script>
}