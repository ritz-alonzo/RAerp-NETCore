@inject IModelAttributeHelper modelAttributeHelper;

@model BusinessEntityListModel

@{
    Layout = null;
}

<div class="card">
    <div class="card-body">
        @{
            // working data table creation
            // just needed to know the arrangement of records for tbody
            var gridTable = new DataTablesModel();
            gridTable.GridName = "businessEntities_table";
            gridTable.ClassName = "table-dark";
            gridTable.UrlController = "BusinessEntities";
            gridTable.UrlEdit = "Index";
            gridTable.UrlDelete = "Delete";
            gridTable.UrlGridPartialViewAction = "BusinessEntityListSearch";
            gridTable.EditEnabled = true;
            gridTable.DeleteEnabled = true;
            gridTable.ConfigurationEnabled = false;

            gridTable.Records = Model.Items;

            gridTable.ColumnCollection = new List<ColumnDefinition>
            {
                new ColumnDefinition(nameof(BusinessEntityModel.Id))
                {
                    IsPrimaryKey = true,
                    Visible = false,
                },
                new ColumnDefinition(nameof(BusinessEntityModel.Code))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<BusinessEntityModel>(nameof(BusinessEntityModel.Code)),
                    Visible = true,
                    // RedirectUsingCodeEnabled = @Model.UI.RedirectByCodeEnabled
                    // for now value is true
                    RedirectUsingCodeEnabled = true
                },
                new ColumnDefinition(nameof(BusinessEntityModel.Name))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<BusinessEntityModel>(nameof(BusinessEntityModel.Name)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(BusinessEntityModel.Description))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<BusinessEntityModel>(nameof(BusinessEntityModel.Description)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(BusinessEntityModel.CategoryId))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<BusinessEntityModel>(nameof(BusinessEntityModel.CategoryId)),
                    Visible = true,
                    ColumnSelectList = Model.Items.Any() ? Model.Items.Select(c => c.AvailableCategories).FirstOrDefault() : new List<SelectListItem>(),
                    ControlType = ControlType.Dropdown
                },
                new ColumnDefinition(nameof(BusinessEntityModel.CreatedOn))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<BusinessEntityModel>(nameof(BusinessEntityModel.CreatedOn)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(BusinessEntityModel.ModifiedOn))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<BusinessEntityModel>(nameof(BusinessEntityModel.ModifiedOn)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(BusinessEntityModel.Status))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<BusinessEntityModel>(nameof(BusinessEntityModel.StatusId)),
                    Visible = true,
                },
                new ColumnDefinition(nameof(BusinessEntityModel.CreatedByUser))
                {
                    Title = modelAttributeHelper.GetModelAttributeDisplayNameValue<BusinessEntityModel>(nameof(BusinessEntityModel.CreatedByUser)),
                    Visible = true,
                    PropertyValueHolder = nameof(BusinessEntityModel.CreatedByUser.FullName),
                },
            };

            @await Html.PartialAsync("~/Views/Shared/Tables/_Table.cshtml", gridTable)
        }
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/Tables/_Pagination.cshtml", Model)

<script type="text/javascript">

    // need to create javascript for this
    // working pressing enter key search use on.keydown
    $('#businessEntities_search').on("keyup", function (e) {
        // will prevent looping
        e.stopImmediatePropagation();
        // when focus was removed
        var formSearchId = 'businessEntities_search';
        var url = '@Url.Action("BusinessEntityListSearch", "BusinessEntities")'
        var partialViewId = 'businessEntities';
        SearchFunction(formSearchId, url, partialViewId);
        // when enter is pressed
        //if (e.keyCode == 13) {
        //    var formSearchId = 'businessEntities_search';
        //    var url = '@Url.Action("BusinessEntityListSearch", "BusinessEntities")'
        //    var partialViewId = 'entityTypes';
        //    SearchFunction(formSearchId, url, partialViewId);
        //}
        // else do nothing
    });
    var tableId = "businessEntities_table";
    formatStatus(tableId);

</script>



