@model OrderModel

<div class="row">
    <div class="form-content-header-group">
        <i class="fa fa-info-circle"></i> @HtmlContentConstants.InfoHeader
    </div>
    <div class="col-md-9">
        <div class="row">
            <div class="custom-input-set col-md-6">
                <label asp-for="@Model.FormNbr" class="form-label" data-required="true"></label>@*working - for testing add data-required=true for fields that are required*@
                <input asp-for="@Model.FormNbr" type="text" class="form-control" autocomplete="off" readonly />
                <span asp-validation-for="@Model.FormNbr" class="text-danger"></span>
            </div>
            <div class="custom-input-set col-md-6">
                <label asp-for="@Model.ServiceId" class="form-label"></label>
                <select asp-for="ServiceId"
                        class="select2 form-select shadow-none"
                        asp-items="@(new SelectList(Model.AvailableServices, "Value", "Text"))">
                </select>
                <span asp-validation-for="@Model.ServiceId" class="text-danger"></span>
            </div>
            <div class="custom-input-set col-md-6">
                <label asp-for="@Model.OrderDate" class="form-label"></label>
                <input asp-for="@Model.OrderDate" type="datetime-local" class="form-control" autocomplete="off" />
                <span asp-validation-for="@Model.OrderDate" class="text-danger"></span>
            </div>
            <div class="custom-input-set col-md-6">
                <label asp-for="@Model.CustomerName" class="form-label"></label>
                <input asp-for="@Model.CustomerName" type="text" class="form-control" autocomplete="off" />
                <span asp-validation-for="@Model.CustomerName" class="text-danger"></span>
            </div>
            <div class="custom-input-set col-md-6">
                <label asp-for="@Model.Description" class="form-label"></label>
                <input asp-for="@Model.Description" type="text" class="form-control" autocomplete="off" />
                <span asp-validation-for="@Model.Description" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="row">
            <div class="custom-input-set col-md-12">
                <label asp-for="@Model.TotalQty" class="form-label"></label>
                <input asp-for="@Model.TotalQty" type="number" class="form-control" autocomplete="off" readonly />
                <span asp-validation-for="@Model.TotalQty" class="text-danger"></span>
            </div>
            <div class="custom-input-set col-md-12">
                <label asp-for="@Model.TotalDiscountAmount" class="form-label"></label>
                <input asp-for="@Model.TotalDiscountAmount" type="number" class="form-control" autocomplete="off" readonly />
                <span asp-validation-for="@Model.TotalDiscountAmount" class="text-danger"></span>
            </div>
            <div class="custom-input-set col-md-12">
                <label asp-for="@Model.TotalGrossAmount" class="form-label"></label>
                <input asp-for="@Model.TotalGrossAmount" type="number" class="form-control" autocomplete="off" readonly />
                <span asp-validation-for="@Model.TotalGrossAmount" class="text-danger"></span>
            </div>
            <div class="custom-input-set col-md-12">
                <label asp-for="@Model.TotalVatAmount" class="form-label"></label>
                <input asp-for="@Model.TotalVatAmount" type="number" class="form-control" autocomplete="off" readonly />
                <span asp-validation-for="@Model.TotalVatAmount" class="text-danger"></span>
            </div>
            <div class="custom-input-set col-md-12">
                <label asp-for="@Model.TotalNetAmount" class="form-label"></label>
                <input asp-for="@Model.TotalNetAmount" type="number" class="form-control" autocomplete="off" readonly />
                <span asp-validation-for="@Model.TotalNetAmount" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>