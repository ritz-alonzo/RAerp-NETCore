@model OrderModel

@{
    ViewData["Title"] = string.Format(HtmlContentFormat.PageTitle, Model.FormTypeName);
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    HtmlActiveNodeMenu.SetActivePluginMenu(Context, Model.FormTypeSystemName);
}

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(c => c.Id)
    <div class="form-content-header-title">
        @{
            if (Model.IsNewDoc)
            {
                <text>@Html.Raw(string.Format(HtmlContentFormat.HeaderTitle, Model.FormTypeName, HtmlContentConstants.NewRecord))</text>
            }
            else
            {
                <text>@Html.Raw(string.Format(HtmlContentFormat.HeaderTitle, Model.FormTypeName, Model.FormNbr))</text>
            }
        }
    </div>
    <div class="form-content-header-control">
        <div class="form-content-back-redirection-control">
            <a asp-action="List" asp-controller="Orders"><i class="fa fa-arrow-left"></i> Back to List</a>
        </div>
        <div>
            <input type="submit" value="Save" class="btn btn-success" />
        </div>
    </div>
    <hr />
    <div class="row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @await Html.PartialAsync("~/Plugins/RA.OrdersManagement/Views/Orders/_CreateAndEdit.cshtml", Model)
    </div>

</form>

@section scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

