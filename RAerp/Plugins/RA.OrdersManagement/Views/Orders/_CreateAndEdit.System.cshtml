@model OrderModel

<div class="row">
    <div class="form-content-header-group">
        <i class="fa fa-cogs"></i> @HtmlContentConstants.SystemHeader
    </div>
    <div class="row">
        <div class="custom-input-set col-md-4">
            <label asp-for="@Model.CreatedByUser.FullName" class="form-label"></label>
            <input asp-for="@Model.CreatedByUser.FullName" type="text" class="form-control" autocomplete="off" readonly />
            <span asp-validation-for="@Model.CreatedByUser.FullName" class="text-danger"></span>
            <input asp-for="@Model.CreatedById" type="hidden" />
        </div>
        <div class="custom-input-set col-md-4">
            <label asp-for="@Model.CreatedOn" class="form-label"></label>
            <input asp-for="@Model.CreatedOn" type="datetime" id="datepicker-autoclose" class="form-control" autocomplete="off" readonly />
            <span asp-validation-for="@Model.CreatedOn" class="text-danger"></span>
        </div>
        <div class="custom-input-set col-md-4">
            <label asp-for="@Model.ModifiedOn" class="form-label"></label>
            <input asp-for="@Model.ModifiedOn" type="datetime" id="datepicker-autoclose" class="form-control" autocomplete="off" readonly />
            <span asp-validation-for="@Model.ModifiedOn" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="custom-input-set col-md-4">
            <label asp-for="@Model.Status" class="form-label"></label>
            <input asp-for="@Model.Status" type="text" class="form-control" autocomplete="off" readonly />
            <span asp-validation-for="@Model.Status" class="text-danger"></span>
        </div>
        <div class="custom-input-set col-md-4">
            <label asp-for="@Model.ApprovedByUser.FullName" class="form-label"></label>
            <input asp-for="@Model.ApprovedByUser.FullName" type="text" class="form-control" autocomplete="off" readonly />
            <span asp-validation-for="@Model.ApprovedByUser.FullName" class="text-danger"></span>
            <input asp-for="@Model.ApprovedById" type="hidden" />
        </div>
        <div class="custom-input-set col-md-4">
            <label asp-for="@Model.ApprovedOn" class="form-label"></label>
            <input asp-for="@Model.ApprovedOn" type="datetime" id="datepicker-autoclose" class="form-control" autocomplete="off" readonly />
            <span asp-validation-for="@Model.ApprovedOn" class="text-danger"></span>
        </div>
    </div>
</div>