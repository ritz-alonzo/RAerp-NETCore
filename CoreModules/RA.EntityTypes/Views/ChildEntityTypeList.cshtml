@model EntityTypeSearchModel

@{
    ViewData["Title"] = Model.EntityTypeName;
    Layout = "~/Views/Shared/Layouts/_AdminLayout.cshtml";
    HtmlActiveNodeMenu.SetActivePluginMenu(Context, Model.EntityTypeSystemName);
}

<div class="float-right">
    <button type="button" class="create-child-modal-trigger btn btn-primary"
            data-create-child-url="@Url.Action("CreateChildEntity", "EntityTypes")"
            data-create-child-title="Create Child Entity"
            data-create-child-id="@Model.SearchParentEntityTypeId"
            data-bs-toggle="modal"
            data-bs-target="#childEntityCreationModal">
        <i class="fa fa-plus"></i>
        @HtmlContentConstants.Create
    </button>
</div>
<div class="col-md-9">
    <h2>@Model.EntityTypeName</h2>
</div>
<form-search id="childEntityTypes_search">
    @Html.HiddenFor(c => c.PageNumber)
    @Html.HiddenFor(c => c.PageSize)
    @Html.HiddenFor(c => c.TotalItems)
    @Html.HiddenFor(c => c.SearchParentEntityTypeId)
    @Html.HiddenFor(c => c.ChildEntitySearchEnabled)
    <div id="search">
        <div class="card">
            <div class="card-header-search">
                <h4 class="text-muted">Search</h4>
            </div>
            <div class="card-body-search">
                <div class="row">
                    <div class="col-md-6">
                        <div class="input-group">
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="fa fa-search"></i></span>
                            </div>
                            <input asp-for="SearchQuery" class="form-control" placeholder="Search.." autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Date: </span>
                            </div>
                            <input name="SearchInstalledOn" id="datepicker-autoclose" class="form-control" type="date" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form-search>

<div id="childEntityTypes">
    @await Html.PartialAsync("~/Plugins/RA.EntityTypes/Views/_ChildEntityTypeListSearch.cshtml", Model.EntityTypes)
    @*<partial name="_EntityTypeList" model="@Model.EntityTypes" />*@
</div>


@section scripts{
    <script>

    </script>
}