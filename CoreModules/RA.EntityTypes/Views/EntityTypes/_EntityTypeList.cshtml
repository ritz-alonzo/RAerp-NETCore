@model EntityTypeListModel

@{
    Layout = null;
}

<div class="card">
    <div class="card-body">
        @{
            // working data table creation
            // just needed to know the arrangement of records for tbody
            var gridTable = new DataTablesModel();
            gridTable.GridName = "entityTypes_table";
            gridTable.ClassName = "table-dark";
            gridTable.UrlController = "EntityTypes";
            gridTable.UrlEdit = "Update";
            gridTable.UrlDelete = "Delete";
            gridTable.UrlGridPartialViewAction = "EntityTypeListSearch";
            gridTable.EditEnabled = true;
            gridTable.DeleteEnabled = true;
            gridTable.ConfigurationEnabled = true;

            gridTable.Records = Model.Items;

            gridTable.ColumnCollection = new List<ColumnDefinition>
            {
                new ColumnDefinition(nameof(EntityTypeModel.Id))
                {
                    IsPrimaryKey = true,
                    Visible = false,
                },
                new ColumnDefinition(nameof(EntityTypeModel.EntityName))
                {
                    Title = "Entity Name",
                    Visible = true,
                },
                new ColumnDefinition(nameof(EntityTypeModel.EntitySystemName))
                {
                    Title = "Entity SystemName",
                    Visible = true,
                },
                new ColumnDefinition(nameof(EntityTypeModel.InstalledOn))
                {
                    Title = "Installed On",
                    Visible = true,
                },
                new ColumnDefinition(nameof(EntityTypeModel.UnInstalledOn))
                {
                    Title = "UnInstalled On",
                    Visible = true,
                },
                new ColumnDefinition(nameof(EntityTypeModel.Installed))
                {
                    Title = "Installed",
                    ControlType = ControlType.Checkbox,
                    Visible = true,
                },
                new ColumnDefinition(nameof(EntityTypeModel.PluginConfigurationUrl))
                {
                    Title = "PluginConfigurationUrl",
                    Visible = false,
                    ShowConfiguration = true
                },
            };

            @await Html.PartialAsync("~/Views/Shared/Tables/_Table.cshtml", gridTable)
        }
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/Tables/_Pagination.cshtml", Model)

@* Modal of plugin config *@
<div class="modal fade" id="pluginConfigurationModal" tabindex="-1" aria-labelledby="pluginConfigurationModalLabel" 
        aria-hidden="true" style="padding-top: 100px;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pluginConfigurationModalLabel"></h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">x</span>
                </button>
            </div>
            <div class="modal-body">
                <form-ajax id="pluginConfigData" data-config-post-action="">

                </form-ajax>
            </div>
            <div class="modal-footer">
                <button id="pluginConfigSaveBtn" class="btn btn-success btn-sm" type="button">Save</button>
            </div>
        </div>
    </div>
</div>
@* will move this scripts to another layout to load necessary scripts to load properly *@

<script type="text/javascript">
    var timeOut = null;
    $('#entityTypes_search').on("input", function (e) {
        if (e.key === 'Enter' || e.keyCode === 13) return;
        var formSearchId = 'entityTypes_search';
        var url = '@Url.Action("EntityTypeListSearch", "EntityTypes")'
        var partialViewId = 'entityTypes';
        clearTimeout(timeOut); 
        timeOut = setTimeout(function (e) { SearchFunction(formSearchId, url, partialViewId); }, 500);
    });

    // cannot use id because it will be the same for all buttons
    $('.plugin-config-modal-trigger').on('click', (e) => {
        console.log('hello world modal');
        var selectedButton = $(e.currentTarget);
        var pluginConfigUrl = selectedButton.attr('data-plugin-config-url');
        if (pluginConfigUrl == null || pluginConfigUrl == '') {
            alert('Failed to load configuration form');
        }
        var pluginConfigTitle = selectedButton.attr('data-plugin-config-title');
        $('#pluginConfigurationModalLabel').html(pluginConfigTitle);

        var pluginEntityTypeId = selectedButton.attr('data-plugin-type-id');
        if (pluginEntityTypeId == null || pluginEntityTypeId == '') {
            alert('Failed to load configuration form');
        }

        $.ajax({
            url: pluginConfigUrl,
            method: 'GET',
            data: {
                entityTypeId: pluginEntityTypeId
            },
        })
        .done((data) => {
            $('#pluginConfigData').html(data);
            $('#pluginConfigData').attr('data-config-post-action', pluginConfigUrl);
            // to show/hide button
            //$('#pluginConfigSaveBtn').css('display', '');
        })
        .fail((data) => {
            console.log('Failed to load configuration form');
        });
        //$('#pluginConfigurationModal').modal("show");
    })

    $('.modal').on('hidden.bs.modal', (e) => {
        $('#pluginConfigData').html("");
        $('#pluginConfigurationModalLabel').html("");
    });

    // post save action of modal
    $('#pluginConfigSaveBtn').on('click', (e) => {
        var configPostAction = $('#pluginConfigData').attr('data-config-post-action');
        if (configPostAction == null || configPostAction == '') {
            alert('Save Action not found.');
        }
        var configPluginDataId = 'pluginConfigData';

        ConfigurationPost(configPluginDataId, configPostAction);
    });

</script>



