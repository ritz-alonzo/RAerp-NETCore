@model EntityTypeListModel

@{
    Layout = null;
}

<div class="card">
    <div class="card-body">
        @{
            // working data table creation
            // just needed to know the arrangement of records for tbody
            var gridTable = new DataTablesModel();
            gridTable.GridName = "childEntityTypes_table";
            gridTable.ClassName = "table-dark";
            gridTable.UrlController = "EntityTypes";
            gridTable.UrlEdit = "Update";
            gridTable.UrlDelete = "Delete";
            gridTable.UrlGridPartialViewAction = "ChildEntityTypeListSearch";
            gridTable.EditEnabled = true;
            gridTable.DeleteEnabled = true;
            gridTable.ConfigurationEnabled = true;

            gridTable.Records = Model.Items;

            gridTable.ColumnCollection = new List<ColumnDefinition>
            {
                new ColumnDefinition(nameof(EntityTypeModel.Id))
                {
                    IsPrimaryKey = true,
                    Visible = false,
                },
                new ColumnDefinition(nameof(EntityTypeModel.EntityName))
                {
                    Title = "Entity Name",
                    Visible = true,
                },
                new ColumnDefinition(nameof(EntityTypeModel.EntitySystemName))
                {
                    Title = "Entity SystemName",
                    Visible = true,
                    IsSystemName = true,
                },
                new ColumnDefinition(nameof(EntityTypeModel.InstalledOn))
                {
                    Title = "Installed On",
                    Visible = true,
                },
                new ColumnDefinition(nameof(EntityTypeModel.UnInstalledOn))
                {
                    Title = "UnInstalled On",
                    Visible = true,
                },
                new ColumnDefinition(nameof(EntityTypeModel.Installed))
                {
                    Title = "Installed",
                    ControlType = ControlType.Checkbox,
                    Visible = true,
                },
                new ColumnDefinition(nameof(EntityTypeModel.PluginConfigurationUrl))
                {
                    Title = "PluginConfigurationUrl",
                    Visible = false,
                    ShowConfiguration = true
                },
            };

            @await Html.PartialAsync("~/Views/Shared/Tables/_Table.cshtml", gridTable)
        }
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/Tables/_Pagination.cshtml", Model)

@* Modal of plugin config *@
<div class="modal fade" id="pluginConfigurationModal" tabindex="-1" aria-labelledby="pluginConfigurationModalLabel"
     aria-hidden="true" style="padding-top: 100px;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pluginConfigurationModalLabel"></h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">x</span>
                </button>
            </div>
            <div class="modal-body">
                <form-ajax id="pluginConfigData" data-config-post-action="">

                </form-ajax>
            </div>
            <div class="modal-footer">
                <button id="pluginConfigSaveBtn" class="btn btn-success btn-sm" type="button">Save</button>
            </div>
        </div>
    </div>
</div>

@* Modal of Child Entity Creation *@
<div class="modal fade" id="childEntityCreationModal" tabindex="-1" aria-labelledby="childEntityCreationModalLabel" 
        aria-hidden="true" style="padding-top: 100px;">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="childEntityCreationModalLabel"></h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">x</span>
                </button>
            </div>
            <div class="modal-body">
                <form-ajax id="childEntityCreationData" data-config-post-action="">

                </form-ajax>
            </div>
            <div class="modal-footer">
                <button id="childEntityCreationSaveBtn" class="btn btn-success btn-sm" type="button">Save</button>
            </div>
        </div>
    </div>
</div>
@* will move this scripts to another layout to load necessary scripts to load properly *@

<script type="text/javascript">

    // need to create javascript for this
    // working pressing enter key search use on.keydown
    $('#childEntityTypes_search').on("change", function (e) {
        // will prevent looping
        e.stopImmediatePropagation();
        // when focus was removed
        var formSearchId = 'childEntityTypes_search';
        var url = '@Url.Action("ChildEntityTypeListSearch", "EntityTypes")'
        var partialViewId = 'childEntityTypes';
        SearchFunction(formSearchId, url, partialViewId);
        // when enter is pressed
        //if (e.keyCode == 13) {
        //    var formSearchId = 'childEntityTypes_search';
        //    var url = '@Url.Action("ChildEntityTypeListSearch", "EntityTypes")'
        //    var partialViewId = 'childEntityTypes';
        //    SearchFunction(formSearchId, url, partialViewId);
        //}
        // else do nothing
    });

    // cannot use id because it will be the same for all buttons
    $('.create-child-modal-trigger').on('click', (e) => {
        
        // check if already opened modal
        // will prevent looping
        e.stopImmediatePropagation();

        var createEntityModal = $('#childEntityCreationModal');
        console.log(createEntityModal);

        console.log('hello world modal');
        var selectedButton = $(e.currentTarget);
        var createChildEntityUrl = selectedButton.attr('data-create-child-url');
        if (createChildEntityUrl == null || createChildEntityUrl == '') {
            alert('Failed to load creation form');
        }
        var createChildEntityTitle = selectedButton.attr('data-create-child-title');
        $('#childEntityCreationModalLabel').html(createChildEntityTitle);

        var parentEntityTypeId = selectedButton.attr('data-create-child-id');
        if (parentEntityTypeId == null || parentEntityTypeId == '') {
            alert('Failed to load creation form');
        }

        $.ajax({
            url: createChildEntityUrl,
            method: 'GET',
            data: {
                parentEntityTypeId: parentEntityTypeId,
            },
        })
        .done((data) => {
            $('#childEntityCreationData').html(data);
                $('#childEntityCreationData').attr('data-config-post-action', createChildEntityUrl);
            // to show/hide button
            //$('#pluginConfigSaveBtn').css('display', '');
        })
        .fail((data) => {
            console.log('Failed to save entity');
        });
        //$('#pluginConfigurationModal').modal("show");
    })

    // post save action of modal
    $('#childEntityCreationSaveBtn').on('click', (e) => {
        var createPostAction = $('#childEntityCreationData').attr('data-config-post-action');
        if (createPostAction == null || createPostAction == '') {
            alert('Save Action not found.');
        }
        var createEntityDataId = 'childEntityCreationData';

        CreateChildEntityPost(createEntityDataId, createPostAction);
    });

    $('#childEntityCreationModal').on('hidden.bs.modal', (e) => {
        console.log('hiding modal');
        $('#childEntityCreationData').html("");
        $('#childEntityCreationModalLabel').html("");
    });


    // cannot use id because it will be the same for all buttons
    $('.plugin-config-modal-trigger').on('click', (e) => {
        console.log('hello world modal');
        var selectedButton = $(e.currentTarget);
        var pluginConfigUrl = selectedButton.attr('data-plugin-config-url');
        if (pluginConfigUrl == null || pluginConfigUrl == '') {
            alert('Failed to load configuration form');
        }
        var pluginConfigTitle = selectedButton.attr('data-plugin-config-title');

        $('#pluginConfigurationModalLabel').html(pluginConfigTitle);

        var pluginEntityTypeId = selectedButton.attr('data-plugin-type-id');
        if (pluginEntityTypeId == null || pluginEntityTypeId == '') {
            alert('Failed to load configuration form');
        }

        var originalSystemName = selectedButton.attr('data-plugin-config-systemName');

        $.ajax({
            url: pluginConfigUrl,
            method: 'GET',
            data: {
                entityTypeId: pluginEntityTypeId,
                systemName: originalSystemName,
            },
        })
        .done((data) => {
            $('#pluginConfigData').html(data);
            $('#pluginConfigData').attr('data-config-post-action', pluginConfigUrl);
            // to show/hide button
            //$('#pluginConfigSaveBtn').css('display', '');
        })
        .fail((data) => {
            console.log('Failed to load configuration form');
        });
        //$('#pluginConfigurationModal').modal("show");
    })

    $('#pluginConfigModal').on('hidden.bs.modal', (e) => {
        $('#pluginConfigData').html("");
        $('#pluginConfigurationModalLabel').html("");
    });

    // post save action of modal
    $('#pluginConfigSaveBtn').on('click', (e) => {
        var configPostAction = $('#pluginConfigData').attr('data-config-post-action');
        if (configPostAction == null || configPostAction == '') {
            alert('Save Action not found.');
        }
        var configPluginDataId = 'pluginConfigData';

        ConfigurationPost(configPluginDataId, configPostAction);
    });

</script>



