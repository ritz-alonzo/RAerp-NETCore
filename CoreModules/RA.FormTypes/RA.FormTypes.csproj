<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
	  <OutputPath>..\..\RAerp\Plugins\RA.FormTypes</OutputPath>
	  <OutDir>$(OutputPath)</OutDir>
	  <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
	  <!-- Compile views into the plugin's own assembly -->
	  <RazorCompileOnBuild>true</RazorCompileOnBuild>
	  <RazorCompileOnPublish>true</RazorCompileOnPublish>
	  <!-- Prevent duplicate/leaking of shared static-web-asset manifests across plugins -->
	  <GenerateStaticWebAssetsManifest>false</GenerateStaticWebAssetsManifest>
	  <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
	  <ProjectReference Include="..\..\Libraries\RA.Core\RA.Core.csproj">
		  <Private>False</Private>
		  <CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
		  <CopyLocal>False</CopyLocal>
	  </ProjectReference>
	  <ProjectReference Include="..\..\Libraries\RA.Data\RA.Data.csproj">
		  <Private>False</Private>
		  <CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
		  <CopyLocal>False</CopyLocal>
	  </ProjectReference>
	  <ProjectReference Include="..\..\RAerp\RAerp.csproj">
		  <Private>False</Private>
		  <CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
		  <CopyLocal>False</CopyLocal>
	  </ProjectReference>
  </ItemGroup>

</Project>
